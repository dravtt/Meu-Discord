# Configuração do Voka. O install.sh copia este modelo para deploy/.env e gera as senhas.
# Nunca envie o deploy/.env a ninguém.

# Domínio público (o proxy reverso da VPS cuida do HTTPS dele)
VOKA_DOMAIN=vokaapp.com.br
# IP público da VPS, anunciado às chamadas (o preflight.sh mostra o valor)
VOKA_PUBLIC_IP=

# Senhas: geradas pelo install.sh
DB_PASSWORD=
JWT_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Portas. Só mude se já estiverem em uso na VPS.
# Internas (só 127.0.0.1, o proxy reverso aponta para elas):
VOKA_APP_PORT=3001
VOKA_LIVEKIT_PORT=7880
# Públicas (abrir no firewall do servidor e do provedor):
VOKA_RTC_TCP_PORT=7881
VOKA_RTC_UDP_PORT=7882

# E-mails de verificação. Com Gmail: senha de app, sem espaços, e o @ escrito como %40.
# SMTP_URL=smtps://seuemail%40gmail.com:SENHADEAPP@smtp.gmail.com:465
# MAIL_FROM=Voka <seuemail@gmail.com>
# Contas com acesso a Configurações > Administração (separe por vírgula). Vazio: a primeira conta criada.
# NEXO_ADMINS=
