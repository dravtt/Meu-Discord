PORT=3001
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo
JWT_SECRET=troque-isto-por-um-segredo-longo
# Public URL of the web app, used for CORS.
WEB_ORIGIN=http://localhost:5173
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
UPLOAD_DIR=./uploads
# Folder with the built web app (npm run build). Served at / when present.
WEB_DIST=../web/dist
# E-mail for sign-up codes. With Gmail: turn on 2-step verification, create an "app password"
# and put it here (no spaces). Without SMTP_URL the code is printed in this server's console.
# SMTP_URL=smtps://seuemail%40gmail.com:SENHA_DE_APP@smtp.gmail.com:465
# MAIL_FROM=Voka <seuemail@gmail.com>
# Max servers one person can be in.
# MAX_SERVERS_PER_USER=100
# Usernames (comma separated) that can open Configurações > Administração. Empty: the first account created.
# NEXO_ADMINS=jacques
# While the beta is open, new accounts get the insígnia Beta. Set to off when the beta ends.
# NEXO_BETA=off
